# Copie a .env.test y complete. Requisitos que validan los scripts (scripts/test-env.mjs):
#  - MYSQL_HOST debe ser localhost / 127.0.0.1
#  - MYSQL_DATABASE debe terminar en _test
# Crear BD/usuario local (MySQL de Homebrew):
#   mysql -uroot -e "CREATE DATABASE appetiquetado_test; CREATE USER 'appetiquetado_test'@'localhost' IDENTIFIED BY '<clave>'; GRANT ALL ON appetiquetado_test.* TO 'appetiquetado_test'@'localhost';"
MYSQL_HOST=127.0.0.1
MYSQL_USER=appetiquetado_test
MYSQL_PASSWORD=<clave-local>
MYSQL_DATABASE=appetiquetado_test
PORT=3101
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD=<clave-de-prueba>
E2E_USER=superadmin
E2E_PASS=<misma-clave-de-prueba>
# Las pruebas de carga E2E hacen cientos de peticiones desde 127.0.0.1
RATE_LIMIT_MOVEMENTS_PER_MIN=100000
RATE_LIMIT_LOGIN_PER_MIN=100000
RATE_LIMIT_LABELS_PER_MIN=100000
