{
  "name": "appetiquetado",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:force": "vite --force",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "server": "node server/index.cjs",
    "start": "node server/index.cjs",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:api": "node scripts/e2e-api.mjs",
    "verify": "npm run lint && npm run typecheck && npm run test",
    "server:test": "node --env-file=.env.test server/index.cjs",
    "db:test:reset": "node scripts/test-env.mjs reset",
    "test:all": "npm run verify && npm run test:e2e && npm run test:e2e:api",
    "test:smoke:remote": "playwright test --grep @smoke",
    "db:staging:init": "node scripts/db-staging-init.mjs",
    "dev:test": "API_PROXY_TARGET=http://127.0.0.1:3101 vite --port 5175 --strictPort",
    "server:staging": "APP_ENV=staging PORT=3201 node --env-file=.env.staging server/index.cjs",
    "dev:staging": "API_PROXY_TARGET=http://127.0.0.1:3201 vite --port 5176 --strictPort",
    "server:prod": "APP_ENV=production node server/index.cjs"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "html2canvas": "^1.4.1",
    "html5-qrcode": "^2.3.8",
    "jspdf": "^4.2.1",
    "mysql2": "^3.12.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "jsdom": "^30.1.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.4",
    "vitest": "^5.0.3"
  }
}
